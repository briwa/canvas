{
  "name": "@briwa.dev/canvas",
  "version": "0.4.3",
  "description": "A tiny canvas animations",
  "homepage": "https://github.com/briwa/canvas#readme",
  "bugs": {
    "url": "https://github.com/briwa/canvas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/briwa/canvas.git"
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./dist/index.iife.js": "./dist/index.iife.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.umd.cjs",
  "unpkg": "./dist/index.iife.js",
  "jsdelivr": "./dist/index.iife.js",
  "directories": {
    "test": "test"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "deploy-preview": "npm run demo:build && npx wrangler dev",
    "deploy": "npm run demo:build && wrangler deploy",
    "demo:build": "vite build --config vite.config.site.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@briwa.dev/sandbox": "^0.5.11",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.135.0"
  },
  "module": "./dist/index.js",
  "sideEffects": false
}
